# Copia este archivo como .env.prod y completa los valores.
# Nunca subas .env.prod al repositorio.

POSTGRES_DB=levelup
POSTGRES_USER=levelup
POSTGRES_PASSWORD=cambia-esta-clave

# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres

# Dominio público (Caddy obtiene el certificado automáticamente).
DOMAIN=levelup.example.com
CORS_ORIGINS=https://levelup.example.com
COOKIE_SECURE=true
